font-family = Iosevka Term
font-size = 14
background = 222222
foreground = bbbbbb
palette = 0=#222222
palette = 7=#bbbbbb
palette = 8=#444444
palette = 15=#eeeeee
cursor-color = 005577
selection-background = 005577
selection-foreground = eeeeee
background-opacity = 1
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = false
scrollback-limit = 10000000
scrollbar = never
window-decoration = none
window-padding-x = 2
window-padding-y = 2
gtk-titlebar = false
gtk-single-instance = detect
shell-integration = fish
shell-integration-features = no-cursor,title,ssh-env
confirm-close-surface = true
keybind = alt+enter=new_window
keybind = ctrl+shift+comma=reload_config
keybind = alt+space=activate_key_table_once:term
keybind = term/r=reload_config
keybind = term/t=new_tab
keybind = term/x=close_tab:this
keybind = term/q=close_surface
keybind = term/v=new_split:right
keybind = term/s=new_split:down
keybind = term/z=toggle_split_zoom
keybind = term/e=equalize_splits
keybind = term/y=copy_to_clipboard:mixed
keybind = term/p=paste_from_clipboard
