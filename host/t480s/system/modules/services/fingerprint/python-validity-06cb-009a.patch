@@ -76,16 +80,35 @@ class Usb:
     def usb_dev(self):
         return self.dev

+    def cmd_retry_busy(self, out: bytes):
+        for attempt in range(20):
+            try:
+                rsp = self.cmd(out)
+            except ucore.USBTimeoutError:
+                if attempt == 19:
+                    raise
+            else:
+                if len(rsp) < 2:
+                    raise RuntimeError('USB command returned a response shorter than its status word')
+
+                status, = unpack('<H', rsp[:2])
+                if status not in BUSY_STATUSES:
+                    return rsp
+
+            time.sleep(0.5)
+
+        raise RuntimeError('USB command remained busy after 20 attempts')
+
     def send_init(self):
         # self.dev.set_configuration()

         # TODO analyse responses, detect hardware type
