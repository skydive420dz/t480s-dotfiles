         # c28c745a in response is a FwextBuildtime = 0x5A748CC2
-        rsp = self.cmd(unhexlify('4302'))  # get_fw_info()
+        rsp = self.cmd_retry_busy(unhexlify('4302'))  # get_fw_info()

         assert_status(self.cmd(init_hardcoded))

diff --git a/tests/test_usb_retry.py b/tests/test_usb_retry.py
new file mode 100644
--- /dev/null
+++ b/tests/test_usb_retry.py
@@ -0,0 +1,36 @@
+import sys
+from types import ModuleType
+from unittest.mock import patch
+
+usb_core = ModuleType('usb.core')
+usb_core.Device = object
+usb_core.USBError = type('USBError', (Exception,), {})
+usb_core.USBTimeoutError = type('USBTimeoutError', (usb_core.USBError,), {})
+usb_module = ModuleType('usb')
+usb_module.core = usb_core
+sys.modules['usb'] = usb_module
+sys.modules['usb.core'] = usb_core
+
+from validitysensor.usb import Usb
+
+
+def main():
+    usb = Usb()
+    responses = iter((b'\x04\x01', b'\x01\x04', b'\x00\x00'))
+    usb.cmd = lambda _: next(responses)
+
+    with patch('validitysensor.usb.time.sleep') as sleep:
+        assert usb.cmd_retry_busy(b'command') == b'\x00\x00'
+        assert sleep.call_count == 2
+
+    usb.cmd = lambda _: b'\x00'
+    try:
+        usb.cmd_retry_busy(b'command')
+    except RuntimeError as error:
+        assert 'shorter than its status word' in str(error)
+    else:
+        raise AssertionError('short USB response was accepted')
+
+
+if __name__ == '__main__':
+    main()
